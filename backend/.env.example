# Oxylabs Web Scraper API token (Bearer token from https://dashboard.oxylabs.io/)
OXYLABS_API_KEY=placeholder-oxylabs-api-key
# NVIDIA NIM API key (https://build.nvidia.com). PRIMARY AI provider.
NVIDIA_API_KEY=placeholder-nvidia-api-key
# Comma-separated list, tried in order.
NVIDIA_MODELS=meta/muse-glimmer-30b

# Gemini API key (https://aistudio.google.com/apikey). First fallback.
GEMINI_API_KEY=placeholder-gemini-api-key
# Comma-separated list, tried in order. Default follows Google's current Flash model.
# GEMINI_MODELS=gemini-flash-latest

# OpenRouter API key (https://openrouter.ai/keys). Last fallback, used when the
# providers above fail or are rate limited. Free models work with a free account.
OPENROUTER_API_KEY=placeholder-openrouter-api-key

# OpenRouter fallback models. The first one that works is used.
# Browse current free models with: python app.py models
OPENROUTER_MODELS=placeholder

# Optional tuning
# VERDICT_MAX_CHARS=30000
# VERDICT_TIMEOUT=120
# VERDICT_WORKERS=3
# VERDICT_REPORT_DIR=reports

# Website (python web.py)
# HOST=127.0.0.1
# PORT=5000
# VERDICT_WEB_CONCURRENCY=3   # research jobs that may run at once
