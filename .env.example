# ============================================================================
# Verdict — Environment Variables for Vercel Deployment
# ============================================================================
# This file contains placeholders only. Do not commit real credentials.
# Add these to your Vercel project Settings > Environment Variables.
# ============================================================================

# Supabase (REQUIRED)
# ===================
# These are provided by your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Backend only (Render). Used with the service-role key below; the Flask service
# reads SUPABASE_URL under this exact name.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Server-side only, never expose to browser

# Render: Research API URL
# ==========================
# The URL of the deployed Flask research API on Render.
# This should point to your Render service URL, e.g.:
# RESEARCH_API_URL=https://verdict-backend-oqxf.onrender.com
RESEARCH_API_URL=https://your-render-service.onrender.com

# Shared secret between the Next.js relay and the Flask backend (recommended in
# production). Set the same random value on Vercel and Render. It lets the
# backend trust the user id the relay forwards without re-verifying the token.
# Requests still work without it — the relay also forwards the user's Supabase
# bearer token, which the backend verifies itself.
# Generate with: openssl rand -hex 32
VERDICT_RELAY_SECRET=your-random-relay-secret

# Oxylabs (REQUIRED for web scraping)
# ================================
# Get from: https://dashboard.oxylabs.io/
OXYLABS_API_KEY=your-oxylabs-api-key

# AI Provider API Keys (OPTIONAL, for AI-powered research reports)
# ==================================================================
# Order of preference: NVIDIA (primary) → Gemini → OpenRouter (fallback)

# NVIDIA NIM API key (primary AI provider)
# Get from: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key

# Gemini API key (fallback)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter API key (last fallback, works with free account)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Stripe (REQUIRED for payments)
# =================================
# Set these on the backend service (Render). The frontend never sees them.
# Use sk_test_ / whsec_ keys while testing; switch to live keys for production.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
# Public URL of the Next.js app, used for checkout success/cancel redirects.
APP_URL=https://your-vercel-app.vercel.app
# Price IDs created in the Stripe dashboard for each subscription plan.
# Prices are configured in Stripe; the backend validates every amount.
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-id
STRIPE_PRICE_PRO_ANNUAL=price_your-pro-annual-id
STRIPE_PRICE_BIZ_MONTHLY=price_your-business-monthly-id
STRIPE_PRICE_BIZ_ANNUAL=price_your-business-annual-id
# Webhook endpoint to register in Stripe: <APP_URL>/api/webhooks/stripe
# (relays to the Flask backend, which verifies the signature).

# Optional: Custom model lists
# ==============================
# Comma-separated list of OpenRouter models to try (in order)
# OPENROUTER_MODELS=model/a:free,model/b:free

# Optional: Tuning
# ==============
# VERDICT_MAX_CHARS=30000
# VERDICT_TIMEOUT=120
# VERDICT_WORKERS=3

# ============================================================================
# Vercel-Specific
# ============================================================================
# The URL of the deployed Python research function.
# This is automatically set by Vercel when you deploy, but you can also
# set it manually if needed:
# NEXT_PUBLIC_RESEARCH_API_URL=https://your-project.vercel.app/api
#
# If left empty, the frontend (lib/research.ts) will construct relative URLs
# or use the same origin, which works when both frontend and backend are
# deployed under the same Vercel project.
# ============================================================================