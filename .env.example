# ============================================================================
# Verdict — Environment Variables for Vercel Deployment
# ============================================================================
# This file contains placeholders only. Do not commit real credentials.
# Add these to your Vercel project Settings > Environment Variables.
# ============================================================================

# Supabase (REQUIRED)
# ===================
# These are provided by your Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # Server-side only, never expose to browser

# Oxylabs (REQUIRED for web scraping)
# =================================
# Get from: https://dashboard.oxylabs.io/
OXYLABS_API_KEY=your-oxylabs-api-key

# AI Provider API Keys (OPTIONAL, for AI-powered research reports)
# ==================================================================
# Order of preference: NVIDIA (primary) → Gemini → OpenRouter (fallback)

# NVIDIA NIM API key (primary AI provider)
# Get from: https://build.nvidia.com/
NVIDIA_API_KEY=your-nvidia-api-key

# Gemini API key (fallback)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# OpenRouter API key (last fallback, works with free account)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional: Custom model lists
# ==============================
# Comma-separated list of OpenRouter models to try (in order)
# OPENROUTER_MODELS=model/a:free,model/b:free

# Optional: Tuning
# ==============
# VERDICT_MAX_CHARS=30000
# VERDICT_TIMEOUT=120
# VERDICT_WORKERS=3

# ============================================================================
# Vercel-Specific
# ============================================================================
# The URL of the deployed Python research function.
# This is automatically set by Vercel when you deploy, but you can also
# set it manually if needed:
# NEXT_PUBLIC_RESEARCH_API_URL=https://your-project.vercel.app/api
# 
# If left empty, the frontend (lib/research.ts) will construct relative URLs
# or use the same origin, which works when both frontend and backend are
# deployed under the same Vercel project.
# ============================================================================